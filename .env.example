# ==============================================================
# MangasVN - Biến môi trường mẫu cho Production / Staging
# Sao chép file này thành .env và điền các giá trị thực tế
# ==============================================================

# 1. Cơ sở dữ liệu MySQL
MYSQL_ROOT_PASSWORD=ThayBangMatKhauManhNhatCoThe123!
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/mangasvn
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=${MYSQL_ROOT_PASSWORD}

# 2. JWT Secret Key (BẮT BUỘC: Chuỗi tối thiểu 64 ký tự do dùng thuật toán HMAC-SHA512)
JWT_SECRET_KEY=BanHayDoiChuoiBiMatNayThanhMotChuoiNgauNhienDaiToiThieu64KyTuNhe1234567890!@#$%

# 3. Cloudflare R2 Object Storage (Dùng để lưu ảnh bìa truyện và chapter)
CLOUDFLARE_ACCESS_KEY=your_cloudflare_r2_access_key
CLOUDFLARE_SECRET_KEY=your_cloudflare_r2_secret_key
CLOUDFLARE_BUCKET_NAME=comics
CLOUDFLARE_UPLOAD_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_PUBLIC_URL=https://<custom-subdomain>.r2.dev

# 4. Giới hạn dung lượng tải lên (Upload Size Limits)
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=60MB

# 5. Danh sách tên miền được phép CORS (phân tách bởi dấu phẩy)
CORS_ALLOWED_ORIGINS=https://mangasvn.click,https://www.mangasvn.click,http://localhost:8080
